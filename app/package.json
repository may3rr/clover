{
  "name": "citecheck",
  "productName": "Clover",
  "version": "0.1.0",
  "description": "Academic citation health check — docx in, Word comments + tracked changes out.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p site/tsconfig.json --noEmit",
    "gen:types": "node scripts/gen-types.mjs",
    "lint:design": "node scripts/lint-design.mjs",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "dist": "sh scripts/bundle-python.sh && electron-vite build && electron-builder --mac",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "site:record": "node site/scripts/record.mjs",
    "site:icon": "node site/scripts/icon.mjs && rsvg-convert -w 1024 build/icon.svg -o build/icon.png && rsvg-convert -w 180 build/icon.svg -o site/public/apple-touch-icon.png && rsvg-convert -w 1200 site/scripts/.og.svg -o site/public/og.png && rm site/scripts/.og.svg",
    "site:frame": "node site/scripts/frame.mjs",
    "site:film": "node site/scripts/film.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "build": {
    "appId": "com.citecheck.app",
    "productName": "Clover",
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "default",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Clover-mac-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Viewer"
      }
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "citecheck/**/*",
          "benchmarks/*.json",
          "config.example.toml",
          "pyproject.toml",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "dmg": {
      "title": "Clover"
    }
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/node": "26.6.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
